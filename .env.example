# Copy to .env for local dev, or set these as secrets in your host (Cloudflare:
# `wrangler secret put NAME`). NEVER commit real values — .env is git-ignored.

# Neon PostgreSQL connection string
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Secret used to encrypt/sign session cookies. MUST be >= 32 characters and
# unique per environment. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(36).toString('base64url'))"
SESSION_SECRET=replace-with-a-long-random-string-at-least-32-chars
